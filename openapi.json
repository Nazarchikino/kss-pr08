          {
            "name": "page",
            "required": false,
            "in": "query",
            "description": "Номер сторінки (починаючи з 1)",
            "schema": {
              "minimum": 1,
              "default": 1,
              "example": 1,
              "type": "number"
            }
          },
          {
            "name": "pageSize",
            "required": false,
            "in": "query",
            "description": "Кількість елементів на сторінці (від 1 до 50)",
            "schema": {
              "minimum": 1,
              "maximum": 50,
              "default": 10,
              "example": 10,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Сторінка списку користувачів",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "items",
                    "page",
                    "pageSize",
                    "total"
                  ],
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/UserEntity"
                      },
                      "description": "Елементи поточної сторінки"
                    },
                    "page": {
                      "type": "integer",
                      "minimum": 1,
                      "example": 1,
                      "description": "Номер поточної сторінки (починаючи з 1)"
                    },
                    "pageSize": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 50,
                      "example": 10,
                      "description": "Кількість елементів на сторінці"
                    },
                    "total": {
                      "type": "integer",
                      "minimum": 0,
                      "example": 6,
                      "description": "Загальна кількість елементів у колекції"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Потрібна автентифікація",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsEntity"
                }
              }
            }
          },
          "403": {
            "description": "Доступ заборонено",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsEntity"
                }
              }
            }
          },
          "422": {
            "description": "Помилка валідації",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsEntity"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Список користувачів (лише для адміністратора)",
        "tags": [
          "users"
        ]
      }
    },

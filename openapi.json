    "/tickets": {
      "get": {
        "operationId": "listTickets",
        "parameters": [
          {
            "name": "status",
            "required": false,
            "in": "query",
            "description": "Фільтр за станом заявки",
            "schema": {
              "example": "open",
              "allOf": [
                {
                  "$ref": "#/components/schemas/TicketStatus"
                }
              ]
            }
          },
          {
            "name": "priority",
            "required": false,
            "in": "query",
            "description": "Фільтр за пріоритетом заявки",
            "schema": {
              "example": "high",
              "allOf": [
                {
                  "$ref": "#/components/schemas/Priority"
                }
              ]
            }
          },
          {
            "name": "sort",
            "required": false,
            "in": "query",
            "description": "Сортування (префікс `-` означає спадання)",
            "schema": {
              "default": "-createdAt",
              "example": "-createdAt",
              "type": "string",
              "enum": [
                "createdAt",
                "-createdAt",
                "priority",
                "-priority"
              ]
            }
          },
          {
            "name": "authorId",
            "required": false,
            "in": "query",
            "description": "Фільтр за ідентифікатором автора заявки",
            "schema": {
              "minimum": 1,
              "example": 1,
              "type": "number"
            }
          },
          {
            "name": "assigneeId",
            "required": false,
            "in": "query",
            "description": "Фільтр за ідентифікатором призначеного виконавця",
            "schema": {
              "minimum": 1,
              "example": 3,
              "type": "number"
            }
          },
          {
            "name": "q",
            "required": false,
            "in": "query",
            "description": "Пошуковий рядок у назві та описі заявки",
            "schema": {
              "maxLength": 100,
              "example": "HDMI",
              "type": "string"
            }
          },
          {
            "name": "page",
            "required": false,
            "in": "query",
            "description": "Номер сторінки (починаючи з 1)",
            "schema": {
              "minimum": 1,
              "default": 1,
              "example": 1,
              "type": "number"
            }
          },
          {
            "name": "pageSize",
            "required": false,
            "in": "query",
            "description": "Кількість елементів на сторінці (від 1 до 50)",
            "schema": {
              "minimum": 1,
              "maximum": 50,
              "default": 10,
              "example": 10,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Сторінка списку заявок",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "items",
                    "page",
                    "pageSize",
                    "total"
                  ],
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/TicketEntity"
                      },
                      "description": "Елементи поточної сторінки"
                    },
                    "page": {
                      "type": "integer",
                      "minimum": 1,
                      "example": 1,
                      "description": "Номер поточної сторінки (починаючи з 1)"
                    },
                    "pageSize": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 50,
                      "example": 10,
                      "description": "Кількість елементів на сторінці"
                    },
                    "total": {
                      "type": "integer",
                      "minimum": 0,
                      "example": 6,
                      "description": "Загальна кількість елементів у колекції"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Потрібна автентифікація",

  },
  "info": {
    "title": "Helpdesk API – служба технічної підтримки коледжу",
    "description": "REST API серверної частини служби технічної підтримки коледжу (навчальний проєкт курсу «Розробка клієнт-серверних застосувань»)",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "auth",
      "description": "Автентифікація"
    },
    {
      "name": "tickets",
      "description": "Заявки та їх життєвий цикл"
    },
    {
      "name": "comments",
      "description": "Коментарі до заявок"
    },
    {
      "name": "users",
      "description": "Користувачі системи"
    }
  ],
  "servers": [
    {
      "url": "http://localhost:3000/api/v1",
      "description": "Локальний сервер розробки"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "Токен з POST /auth/login"
      }
    },
    "schemas": {
      "ProblemDetailsEntity": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "URI типу проблеми (about:blank – помилка визначається кодом стану HTTP)",
            "example": "about:blank",
            "default": "about:blank"
          },
          "title": {
            "type": "string",
            "description": "Коротка людиночитана назва класу помилки",
            "example": "Ресурс не знайдено"
          },
          "status": {
            "type": "number",
            "description": "HTTP-код стану відповіді",
            "example": 404
          },
          "detail": {
            "type": "string",
            "description": "Докладне пояснення конкретного випадку помилки",
            "example": "Заявку з id=999 не знайдено"
          },
          "instance": {
            "type": "string",
            "description": "Шлях запиту, під час обробки якого виникла помилка",
            "example": "/api/v1/tickets/999"
          },
          "requestId": {
            "type": "string",
            "description": "Унікальний ідентифікатор запиту (X-Request-Id) для кореляції з журналом сервера",
            "example": "8f14e45f-ceea-467a-9538-1b6a97b1e320"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "instance"
        ]
      },
      "Role": {
        "type": "string",
        "enum": [
          "student",
          "teacher",
          "admin"
        ],
        "description": "Роль користувача в системі"
      },
      "UserEntity": {
        "type": "object",
        "properties": {
          "role": {
            "description": "Роль користувача в системі",
            "example": "student",
            "allOf": [
              {
                "$ref": "#/components/schemas/Role"
              }
            ]
          },
          "id": {
            "type": "number",
            "description": "Унікальний ідентифікатор користувача",
            "example": 1
          },
          "fullName": {
            "type": "string",
            "description": "Прізвище та ім’я користувача",
            "example": "Петренко Аліна"
          },
          "email": {
            "type": "string",
            "description": "Корпоративна електронна пошта",
            "example": "a.petrenko@college.example.ua"
          }
        },
        "required": [
          "role",
          "id",
          "fullName",
          "email"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "Електронна пошта користувача коледжу",
            "example": "a.petrenko@college.example.ua",
            "format": "email"
          },
          "password": {
            "type": "string",
            "description": "Пароль користувача (щонайменше 8 символів)",
            "example": "student123",
            "minLength": 8
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "TokenEntity": {
        "type": "object",
        "properties": {
          "tokenType": {
            "enum": [
              "Bearer"
            ],
            "type": "string",
            "description": "Тип токена за схемою HTTP Bearer",
            "example": "Bearer"
          },
          "accessToken": {
            "type": "string",
            "description": "Токен доступу для заголовка Authorization: Bearer <accessToken>",
            "example": "2f1c9a54-8d3e-4b7a-9f1e-6c2d8a4b0e71"
          },
          "expiresIn": {
            "type": "number",
            "description": "Час дії токена в секундах",
            "example": 3600
          }
        },
        "required": [
          "tokenType",
          "accessToken",
          "expiresIn"
        ]
      },
      "TicketStatus": {
        "type": "string",
        "enum": [
          "open",
          "in_progress",
          "resolved",
          "closed"
        ],
        "description": "Поточний стан заявки"
      },
      "Priority": {
        "type": "string",
        "enum": [
          "low",
          "medium",
          "high",
          "critical"
        ],
        "description": "Пріоритет виконання заявки"
      },
      "TicketEntity": {
        "type": "object",
        "properties": {
          "status": {
            "description": "Поточний стан заявки",
            "example": "open",
            "allOf": [
              {
                "$ref": "#/components/schemas/TicketStatus"
              }
            ]
          },
          "priority": {
            "description": "Пріоритет виконання заявки",
            "example": "medium",
            "allOf": [
              {
                "$ref": "#/components/schemas/Priority"
              }
            ]
          },
          "assigneeId": {
            "type": "integer",
            "nullable": true,
            "description": "Виконавець; null – не призначено",
            "example": 3
          },
          "id": {
            "type": "number",
            "description": "Ідентифікатор заявки",
            "example": 1
          },
          "title": {
            "type": "string",
            "description": "Короткий заголовок проблеми",
            "example": "Не працює проєктор в аудиторії 305"
          },
          "description": {
            "type": "string",
            "description": "Докладний опис проблеми",
            "example": "При підключенні ноутбука через HDMI зображення не виводиться."
          },
          "authorId": {
            "type": "number",
            "description": "Ідентифікатор автора заявки",
            "example": 1
          },
          "createdAt": {
            "type": "string",
            "description": "Час створення заявки у форматі ISO 8601 (UTC)",
            "example": "2026-10-01T08:30:00.000Z"
          },
          "updatedAt": {
            "type": "string",
            "description": "Час останнього оновлення заявки у форматі ISO 8601 (UTC)",
            "example": "2026-10-01T09:15:00.000Z"
          },
          "tags": {
            "description": "Мітки (теги) заявки",
            "example": [
              "проєктор",
              "ауд-305"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "status",
          "priority",
          "assigneeId",
          "id",
          "title",
          "authorId",
          "createdAt",
          "updatedAt",
          "tags"
        ]
      },
      "CreateTicketDto": {
        "type": "object",
        "properties": {
          "priority": {
            "description": "Пріоритет заявки (critical доступний лише викладачу та адміністратору)",
            "example": "medium",
            "allOf": [
              {
                "$ref": "#/components/schemas/Priority"
              }
            ]
          },
          "title": {
            "type": "string",
            "description": "Короткий заголовок проблеми (від 1 до 80 символів)",
            "example": "Не працює проєктор в аудиторії 305",
            "minLength": 1,
            "maxLength": 80
          },
          "description": {
            "type": "string",
            "description": "Докладний опис проблеми (до 500 символів)",
            "example": "При підключенні через кабель HDMI зображення відсутнє.",
            "maxLength": 500
          },
          "tags": {
            "description": "Мітки (теги) для категоризації заявки (до 10 елементів)",
            "example": [
              "проєктор",
              "ауд-305"
            ],
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "priority",
          "title"
        ]
      },
      "UpdateTicketDto": {
        "type": "object",
        "properties": {
          "priority": {
            "description": "Пріоритет заявки (critical доступний лише викладачу та адміністратору)",
            "example": "medium",
            "allOf": [
              {
                "$ref": "#/components/schemas/Priority"
              }
            ]
          },
          "title": {
            "type": "string",
            "description": "Короткий заголовок проблеми (від 1 до 80 символів)",
            "example": "Не працює проєктор в аудиторії 305",
            "minLength": 1,
            "maxLength": 80
          },
          "description": {
            "type": "string",
            "description": "Докладний опис проблеми (до 500 символів)",
            "example": "При підключенні через кабель HDMI зображення відсутнє.",
            "maxLength": 500
          },
          "tags": {
            "description": "Мітки (теги) для категоризації заявки (до 10 елементів)",
            "example": [
              "проєктор",
              "ауд-305"
            ],
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "assigneeId": {
            "type": "integer",
            "nullable": true,
            "description": "Ідентифікатор виконавця; null – зняти виконавця",
            "minimum": 1,
            "example": 3
          }
        }
      },
      "ChangeStatusDto": {
        "type": "object",
        "properties": {
          "status": {
            "description": "Новий стан заявки (open → in_progress → resolved → closed)",
            "example": "in_progress",
            "allOf": [
              {
                "$ref": "#/components/schemas/TicketStatus"
              }
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "CommentEntity": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "description": "Ідентифікатор коментаря",
            "example": 1
          },
          "ticketId": {
            "type": "number",
            "description": "Ідентифікатор заявки, до якої належить коментар",
            "example": 1
          },
          "authorId": {
            "type": "number",
            "description": "Ідентифікатор автора коментаря",
            "example": 3
          },
          "text": {
            "type": "string",
            "description": "Текст коментаря",
            "example": "Замінили кабель HDMI, проєктор працює."
          },
          "createdAt": {
            "type": "string",
            "description": "Час додавання коментаря у форматі ISO 8601 (UTC)",
            "example": "2026-10-01T10:00:00.000Z"
          }
        },
        "required": [
          "id",
          "ticketId",
          "authorId",
          "text",
          "createdAt"
        ]
      },
      "CreateCommentDto": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "Текст коментаря (від 1 до 1000 символів)",
            "example": "Перевірили кабель HDMI — потрібна заміна.",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "required": [
          "text"
        ]
      }
    }
  },
  "security": [
    {
      "bearer": []
    }
  ]
}

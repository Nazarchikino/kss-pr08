                  "$ref": "#/components/schemas/ProblemDetailsEntity"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Список коментарів до заявки",
        "tags": [
          "tickets",
          "comments"
        ]
      },
      "post": {
        "operationId": "createTicketComment",
        "parameters": [
          {
            "name": "ticketId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "number"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCommentDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Коментар додано",
            "headers": {
              "Location": {
                "description": "Адреса створеного ресурсу",
                "schema": {
                  "type": "string",
                  "format": "uri-reference",
                  "example": "/api/v1/tickets/7"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommentEntity"
                }
              }
            }
          },
          "400": {
            "description": "Некоректний запит",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsEntity"
                }
              }
            }
          },
          "401": {
            "description": "Потрібна автентифікація",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsEntity"
                }
              }
            }
          },
          "404": {
            "description": "Ресурс не знайдено",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsEntity"
                }
              }
            }
          },
          "422": {
            "description": "Помилка валідації",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsEntity"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Додати коментар до заявки",
        "tags": [
          "tickets",
          "comments"
        ]
      }
    },
    "/tickets/{ticketId}/comments/{commentId}": {
      "get": {
        "operationId": "getTicketComment",
        "parameters": [
